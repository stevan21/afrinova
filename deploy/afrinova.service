[Unit]
Description=AFRINOVA - Gunicorn (Django)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/afrinova
# Django lit lui-même le fichier .env (via python-dotenv), pas besoin d'EnvironmentFile.
ExecStart=/opt/afrinova/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/opt/afrinova/afrinova.sock
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
