# ============================================================
#  AFRINOVA — Variables d'environnement (exemple)
#  Copiez ce fichier en  backend/.env  et adaptez les valeurs.
#  En production, définissez ces variables côté hébergeur.
# ============================================================

# Clé secrète Django (OBLIGATOIRE en prod — générez une valeur unique)
DJANGO_SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire

# Mode : False en production
DJANGO_DEBUG=False

# Domaines autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=afrinova.com,www.afrinova.com,.onrender.com

# Origines de confiance pour le CSRF (https://…) — pour /django-admin/
DJANGO_CSRF_TRUSTED_ORIGINS=https://afrinova.com,https://www.afrinova.com

# Base de données (laisser vide = SQLite local).
# Exemple PostgreSQL :
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/afrinova
DATABASE_URL=
DJANGO_DB_SSL=False

# HTTPS (si le site est servi en https derrière un proxy)
DJANGO_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
